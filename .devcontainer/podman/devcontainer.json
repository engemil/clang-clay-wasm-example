{
    "name": "example_devcontainer_podman",
    "dockerComposeFile": "docker-compose.yml",
    "service": "example_service",
    "shutdownAction": "none",
    "workspaceFolder": "/workspace",
    "remoteUser": "engemil",
    "updateRemoteUserUID": false,
    "postStartCommand": ["sh", "${containerWorkspaceFolder}/scripts/dev.sh", "prepare"],
    "customizations": {
        "vscode": {
            "extensions": [
                "TestMate.vscode-catch2-test-adapter",
                "llvm-vs-code-extensions.vscode-clangd",
                "EditorConfig.EditorConfig",
                "ryanluker.vscode-coverage-gutters",
                "ritwickdey.liveserver",
                "ms-vscode.wasm-dwarf-debugging"
            ],
            "settings": {
                "liveServer.settings.port": 8080,
                "liveServer.settings.root": "/src/build/release"
            }
        }
    }
}
