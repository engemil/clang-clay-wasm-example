{
    "name": "example_devcontainer_docker",
    "dockerComposeFile": "docker-compose.yml",
    "service": "example_service",
    "shutdownAction": "none",
    "workspaceFolder": "/workspace",
    "remoteUser": "engemil",
    "postStartCommand": ["sh", "-c", "git -C /workspace submodule update --init --recursive && bear --output /workspace/compile_commands.json -- make -C /workspace/src -B"],
    "customizations": {
        "vscode": {
            "extensions": [
                "TestMate.vscode-catch2-test-adapter",
                "llvm-vs-code-extensions.vscode-clangd",
                "EditorConfig.EditorConfig",
                "JacquesLucke.gcov-viewer",
                "ritwickdey.liveserver"
            ],
            "settings": {
                "liveServer.settings.port": 8080,
                "liveServer.settings.root": "/src/build"
            }
        }
    }
}