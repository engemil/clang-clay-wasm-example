{
    "name": "example_devcontainer",
    "dockerComposeFile": "docker-compose.yml",
    "service": "example_service",
    "shutdownAction": "none",
    "workspaceFolder": "/workspace",
    "remoteUser": "engemil",
    "customizations": {
        "vscode": {
            "extensions": [
                "ritwickdey.liveserver"
            ],
            "settings": {
                "liveServer.settings.port": 8080,
                "liveServer.settings.root": "/src/build"
            }
        }
    }
}