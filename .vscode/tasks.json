{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "make",
            "args": ["-C", "src"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "make",
            "args": ["-C", "src", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run (Serve)",
            "type": "process",
            "command": "make",
            "args": ["-C", "src", "serve"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Generate compilation database",
            "type": "process",
            "command": "bear",
            "args": [
                "--output",
                "compile_commands.json",
                "--",
                "make",
                "-C",
                "src",
                "-B"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}