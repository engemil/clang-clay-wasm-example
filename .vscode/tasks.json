{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build", "release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build", "debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Rebuild (Release)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "rebuild", "release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Rebuild (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "rebuild", "debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Run (Serve)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "serve"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Test (Native)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test (Native: Valgrind)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native", "valgrind"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test (Native: Sanitizers)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native", "sanitize"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test (Browser)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "browser"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Coverage (Project)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "coverage"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Analyze (Static)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "analyze"],
            "problemMatcher": []
        },
        {
            "label": "Prepare WebAssembly Debug",
            "dependsOrder": "sequence",
            "dependsOn": ["Rebuild (Debug)", "Serve (Debug)"],
            "problemMatcher": []
        },
        {
            "label": "Serve (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "serve", "debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SERVE_WAIT": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^DEV_SERVER_STARTING$",
                    "endsPattern": "^DEV_SERVER_READY$"
                }
            }
        },
        {
            "label": "Stop (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/wait-for-webfsd.sh", "stop"],
            "problemMatcher": []
        },
        {
            "label": "Generate compilation database",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "compdb"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
