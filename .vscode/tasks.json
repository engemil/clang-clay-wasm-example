{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build", "release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build", "debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Rebuild (Release)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "rebuild", "release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Rebuild (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "rebuild", "debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Run (Serve) (Release)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "serve"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Test (Native)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test (Native: Valgrind)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native", "valgrind"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test (Native: Sanitizers)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "native", "sanitize"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test (Browser)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "test", "browser"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Code Coverage",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "coverage"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Analyze (clang-tidy, Clang Static Analyzer, cppcheck)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "analyze"],
            "problemMatcher": []
        },
        {
            "label": "Analyze (Clang Static Analyzer)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "analyze", "clang"],
            "problemMatcher": []
        },
        {
            "label": "Analyze (clang-tidy)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "analyze", "clang-tidy"],
            "problemMatcher": []
        },
        {
            "label": "Analyze (cppcheck)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "analyze", "cppcheck"],
            "problemMatcher": []
        },
        {
            "label": "Prepare WebAssembly Debug",
            "dependsOrder": "sequence",
            "dependsOn": ["Rebuild (Debug)", "Serve (Debug)"],
            "problemMatcher": []
        },
        {
            "label": "Run (Serve) (Debug)",
            "detail": "Build and serve the debug WebAssembly app without launching the debugger.",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "serve", "debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SERVE_WAIT": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^DEV_SERVER_STARTING$",
                    "endsPattern": "^DEV_SERVER_READY$"
                }
            }
        },
        {
            "label": "Stop (Serve)",
            "detail": "Stop webfsd started by the standalone serve command; use Stop (Debug) for the supervised debug task.",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "stop"],
            "problemMatcher": []
        },
        {
            "label": "Stop (Debug)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/wait-for-webfsd.sh", "stop"],
            "problemMatcher": []
        },
        {
            "label": "Format (formats C files)",
            "detail": "Rewrite tracked C sources and headers in place.",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "format"],
            "problemMatcher": []
        },
        {
            "label": "Format (Checks C files)",
            "detail": "Check tracked C sources and headers without editing them.",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "format-check"],
            "problemMatcher": []
        },
        {
            "label": "Validate WebAssembly",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "validate"],
            "problemMatcher": []
        },
        {
            "label": "Inspect WebAssembly",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "inspect"],
            "problemMatcher": []
        },
        {
            "label": "Prepare (dependencies and compilation database)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "prepare"],
            "problemMatcher": []
        },
        {
            "label": "Generate compilation database",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "compdb"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "clang",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
