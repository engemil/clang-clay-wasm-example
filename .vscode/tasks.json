{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/src"]
                }
            ]
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/src"]
                }
            ]
        },
        {
            "label": "Run (Serve)",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "serve"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/src"]
                }
            ]
        },
        {
            "label": "Generate compilation database",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "compdb"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/src"]
                }
            ]
        }
    ]
}